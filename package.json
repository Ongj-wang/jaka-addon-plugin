{
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "extension.CreatePyaddon",
        "description": "创建一个 AddOn 插件项目",
        "title": "addon-plugin:make new addon"
      },
      {
        "command": "extension.buildAddon",
        "title": "addon-plugin:build addon"
      },
      {
        "command": "extension.MakeCustomprograms",
        "shortTitle": "make custom programs",
        "title": "addon-plugin:make custom programs"
      },
      {
        "command": "extension.open_scratch_editor",
        "title": "addon-plugin:open scratch editor"
      },
      {
        "command": "extension.download_requirements",
        "title": "addon-plugin:download requirements"
      }
    ]
  },
  "dependencies": {
