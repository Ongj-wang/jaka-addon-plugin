{
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "extension.generateSettingsJson",
        "description": "生成并格式化 .settings.json 配置文件",
        "shortTitle": "format settings",
        "title": "addon-plugin:format settings.json"
      },
      {
        "command": "extension.enableFilesExclude",
        "description": "启用文件排除规则",
        "shortTitle": "hide files",
        "title": "addon-plugin:enableFilesExclude"
      },
      {
        "command": "extension.disableFilesExclude",
        "description": "禁用文件排除规则",
        "title": "addon-plugin:disableFilesExclude"
      },
      {
        "command": "extension.enableAddonFilesExclude",
        "description": "启用控制器环境中的addon文件排除规则",
        "title": "addon-plugin:enableAddonFilesExclude"
      },
      {
        "command": "extension.CreatePyaddon",
        "description": "创建一个 AddOn 插件项目",
        "title": "addon-plugin:make new addon"
      },
      {
        "command": "extension.buildAddon",
        "title": "addon-plugin:build addon"
      },
      {
        "command": "extension.MakeCustomprograms",
        "shortTitle": "make custom programs",
        "title": "addon-plugin:make custom programs"
      },
      {
        "command": "extension.BuildRelaseAddon",
        "title": "addon-plugin:build release addon"
      },
      {
        "command": "extension.AddAntiModule",
        "title": "addon-plugin:add anti module"
      }
    ]
  },
  "dependencies": {
    "@types/ssh2-sftp-client": "^9.0.5",
    "ssh2-sftp-client": "^12.0.1",
    "tar": "^7.5.2",
    "xml2js": "^0.6.2"
  },
  "description": "JAKA Addon 插件开发工具",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.70.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.9.3"
  },
  "displayName": "JAKA AddOn plugin",
  "engines": {
    "vscode": "^1.70.0"
  },
  "files": [
    "resources/**/*"
  ],
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "jaka-addon-plugin",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/wanghonejie/auto-settings-generator.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "version": "1.3.0"
}
