{
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "extension.generateSettingsJson",
        "title": "format settings.json"
      },
      {
        "command": "extension.enableFilesExclude",
        "title": "enableFilesExclude"
      },
      {
        "command": "extension.disableFilesExclude",
        "title": "disableFilesExclude"
      },
      {
        "command": "extension.enableAddonFilesExclude",
        "title": "enableAddonFilesExclude"
      },
      {
        "command": "extension.CreatePyaddon",
        "title": "make new addon"
      },
      {
        "command": "extension.buildAddon",
        "title": "build addon"
      }
    ]
  },
  "description": "auto generate .settings.json",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.70.0",
    "typescript": "^5.9.3"
  },
  "displayName": "auto-settings-generator",
  "engines": {
    "vscode": "^1.70.0"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "auto-settings-generator",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/wanghonejie/auto-settings-generator.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "version": "0.0.2",
  "dependencies": {
    "tar": "^7.5.2"
  }
}
