{
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "extension.generateSettingsJson",
        "description": "生成并格式化 .settings.json 配置文件",
        "shortTitle": "format settings",
        "title": "auto-settings:format settings.json"
      },
      {
        "command": "extension.enableFilesExclude",
        "description": "启用文件排除规则",
        "shortTitle": "hide files",
        "title": "auto-settings:enableFilesExclude"
      },
      {
        "command": "extension.disableFilesExclude",
        "description": "禁用文件排除规则",
        "title": "auto-settings:disableFilesExclude"
      },
      {
        "command": "extension.enableAddonFilesExclude",
        "description": "启用控制器环境中的addon文件排除规则",
        "title": "auto-settings:enableAddonFilesExclude"
      },
      {
        "command": "extension.CreatePyaddon",
        "description": "创建一个 AddOn 插件项目",
        "title": "auto-settings:make new addon"
      },
      {
        "command": "extension.buildAddon",
        "title": "auto-setting:build addon"
      },
      {
        "command": "extension.MakeCustomPorgrams",
        "shortTitle": "make custom porgrams",
        "title": "auto-setting:make custom porgrams"
      },
      {
        "command": "extension.BuildRelaseAddon",
        "title": "auto-setting:build release addon"
      }
    ]
  },
  "dependencies": {
    "@types/ssh2-sftp-client": "^9.0.5",
    "ssh2-sftp-client": "^12.0.1",
    "tar": "^7.5.2",
    "xml2js": "^0.6.2"
  },
  "description": "auto generate .settings.json",
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/vscode": "^1.70.0",
    "@types/xml2js": "^0.4.14",
    "typescript": "^5.9.3"
  },
  "displayName": "auto-settings-generator",
  "engines": {
    "vscode": "^1.70.0"
  },
  "license": "MIT",
  "main": "./out/extension.js",
  "name": "auto-settings-generator",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/wanghonejie/auto-settings-generator.git"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "version": "0.0.7"
}
